# Node
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rcos

# API Server
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# Auth (JWT)
# NOTE: In production, use long random strings from a secret manager
JWT_ACCESS_SECRET=change-me-access-secret-please-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# OpenAI (for AI compliance engine - Phase 4)
OPENAI_API_KEY=

# Object storage (Phase 2+)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api/v1/attachments/blob
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret-please-use-long-random-string

# QR code scan resolver (public URL a scanner opens)
QR_SCAN_BASE_URL=http://localhost:5173/s

# Jobs runner (Phase 3+)
JOBS_ENABLED=true
JOBS_MATERIALIZER_INTERVAL_SEC=300
JOBS_MATERIALIZER_HORIZON_HOURS=24
