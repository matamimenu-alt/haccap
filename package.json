{
  "name": "rcos",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant Compliance OS (RCOS) - Multi-tenant SaaS for Saudi restaurant chain compliance, HACCP, and food safety",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter \"./artifacts/*\" dev",
    "dev:api": "pnpm --filter @rcos/api-server dev",
    "dev:web": "pnpm --filter @rcos/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @rcos/db generate",
    "db:push": "pnpm --filter @rcos/db push",
    "db:seed": "pnpm --filter @rcos/db seed",
    "api:codegen": "pnpm --filter @rcos/api-client-react codegen"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
